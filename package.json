{
  "name": "tratto",
  "private": true,
  "version": "1.0.0",
  "author": "antoStr",
  "repository": "github:antoStr/tratto",
  "type": "module",
  "scripts": {
    "dev": "node --watch-path=server server/index.ts",
    "app": "electron .",
    "typecheck": "tsc -p .",
    "build": "tsc -p . && vite build",
    "test": "node --test src/editor/*.test.ts server/*.test.ts",
    "fetch:tunnel": "node scripts/fetch-cloudflared.ts",
    "release": "npm version minor -m \"Tratto %s\" && git push --follow-tags",
    "release:patch": "npm version patch -m \"Tratto %s\" && git push --follow-tags",
    "dist:win": "npm run build && node scripts/fetch-cloudflared.ts win && electron-builder --win --x64",
    "app:dev": "TRATTO_DEV=1 electron .",
    "dist:linux": "npm run build && node scripts/fetch-cloudflared.ts linux && electron-builder --linux dir"
  },
  "dependencies": {
    "@hocuspocus/server": "^4.7.0",
    "electron-updater": "6.8.9",
    "express": "^5.2.1",
    "ws": "^8.22.0",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@hocuspocus/provider": "^4.7.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.53.0",
    "perfect-freehand": "^1.2.3",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "zustand": "^5.0.15"
  },
  "main": "electron/main.ts",
  "description": "Tratto: lavagna infinita con penna, righello e condivisione sicura",
  "desktopName": "tratto.desktop"
}
